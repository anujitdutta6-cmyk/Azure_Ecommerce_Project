{
	"name": "DF_Silver_Clean",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adf_to_adls",
						"type": "DatasetReference"
					},
					"name": "BronzeLake"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzSQL_to_adf",
						"type": "DatasetReference"
					},
					"name": "SilverDB"
				}
			],
			"transformations": [
				{
					"name": "DynamicDedupe"
				},
				{
					"name": "TagForUpsert"
				}
			],
			"scriptLines": [
				"parameters{",
				"     TableName as string,",
				"     PrimaryKeyList as string",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'parquet',",
				"     wildcardPaths:['/*.parquet']) ~> BronzeLake",
				"BronzeLake aggregate(each(match(locate(concat(',',name,','),concat(',',$PrimaryKeyList,','))==0), $$ = last($$, true()))) ~> DynamicDedupe",
				"DynamicDedupe alterRow(upsertIf(true())) ~> TagForUpsert",
				"TagForUpsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:(split($PrimaryKeyList, ',')),",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SilverDB"
			]
		}
	}
}