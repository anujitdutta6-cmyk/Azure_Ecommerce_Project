{
	"name": "PL_Ingest_KeyHashDiff",
	"properties": {
		"activities": [
			{
				"name": "Copy_HashDiff_Data",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SP_Log_Start",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT * FROM ', pipeline().parameters.SourceSchemaName, '.', pipeline().parameters.SourceTableName)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzSQL_to_adf",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "@pipeline().parameters.SourceTableName",
							"SchemaName": "@pipeline().parameters.SourceSchemaName"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adf_to_adls",
						"type": "DatasetReference",
						"parameters": {
							"ContainerName": "@pipeline().parameters.TargetSchemaName",
							"DirectoryName": {
								"value": "@concat(pipeline().parameters.SourceTableName, '/hashdiff/year=', formatDateTime(utcnow(), 'yyyy'), '/month=', formatDateTime(utcnow(), 'MM'))",
								"type": "Expression"
							},
							"FileName": {
								"value": "@concat(pipeline().parameters.SourceTableName, '_hashdiff_', formatDateTime(utcnow(), 'yyyyMMdd_HHmmss'), '.parquet')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SP_Log_Start",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[brazilan_Ecommerce].[SP_LogExecution]",
					"storedProcedureParameters": {
						"AdfPipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorMessage": {
							"value": null,
							"type": "String"
						},
						"RunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "Guid"
						},
						"SourceId": {
							"value": {
								"value": "@pipeline().parameters.SourceId",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"Status": {
							"value": "Running",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "sourceAzSQL_to_adf",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Log_Success",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_HashDiff_Data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[brazilan_Ecommerce].[SP_LogExecution]",
					"storedProcedureParameters": {
						"AdfPipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorMessage": {
							"value": null,
							"type": "String"
						},
						"RunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "Guid"
						},
						"SourceId": {
							"value": {
								"value": "@pipeline().parameters.SourceId",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"Status": {
							"value": "Success",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "sourceAzSQL_to_adf",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Log_Failure",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_HashDiff_Data",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[brazilan_Ecommerce].[SP_LogExecution]",
					"storedProcedureParameters": {
						"AdfPipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorMessage": {
							"value": {
								"value": "@activity('Copy_HashDiff_Data').error.message",
								"type": "Expression"
							},
							"type": "String"
						},
						"RunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "Guid"
						},
						"SourceId": {
							"value": {
								"value": "@pipeline().parameters.SourceId",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"Status": {
							"value": "Failed",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "sourceAzSQL_to_adf",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"SourceId": {
				"type": "int"
			},
			"SourceSchemaName": {
				"type": "string"
			},
			"SourceTableName": {
				"type": "string"
			},
			"TargetSchemaName": {
				"type": "string"
			},
			"PrimaryKeyColumns": {
				"type": "string"
			}
		},
		"annotations": []
	}
