{
	"name": "PL_Ingest_Incremental",
	"properties": {
		"activities": [
			{
				"name": "LK_OldWM",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT ISNULL(LastWatermarkValue, '1900-01-01') AS wm\nFROM brazilan_Ecommerce.ctrl_WatermarkTable\nWHERE SourceId = @{pipeline().parameters.SourceId}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzSQL_to_adf",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "brazilan_Ecommerce",
							"SchemaName": "ctrl_WatermarkTable"
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "LK_NewWM",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT CAST(MAX(@{pipeline().parameters.WatermarkColumn}) AS VARCHAR(50)) AS wm\nFROM @{pipeline().parameters.SourceSchemaName}.@{pipeline().parameters.SourceTableName}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzSQL_to_adf",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "pipeline().parameters.SourceSchemaName",
							"SchemaName": "pipeline().parameters.SourceTableName"
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Copy_Incremental_Data",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "LK_OldWM",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "LK_NewWM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT * FROM ', pipeline().parameters.SourceSchemaName, '.', pipeline().parameters.SourceTableName, ' WHERE ', pipeline().parameters.WatermarkColumn, ' > DATEADD(day, -', string(pipeline().parameters.LookbackDays), ', ''', activity('LK_OldWM').output.firstRow.wm, ''') AND ', pipeline().parameters.WatermarkColumn, ' <= ''', activity('LK_NewWM').output.firstRow.wm, '''')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzSQL_to_adf",
						"type": "DatasetReference",
						"parameters": {
							"TableName": {
								"value": "@pipeline().parameters.SourceTableName",
								"type": "Expression"
							},
							"SchemaName": {
								"value": "@pipeline().parameters.SourceSchemaName",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adf_to_adls",
						"type": "DatasetReference",
						"parameters": {
							"ContainerName": "@pipeline().parameters.TargetSchemaName",
							"DirectoryName": "@concat(pipeline().parameters.SourceTableName, '/year=', formatDateTime(utcnow(), 'yyyy'), '/month=', formatDateTime(utcnow(), 'MM'))",
							"FileName": "@concat(pipeline().parameters.SourceTableName, '_', formatDateTime(utcnow(), 'yyyyMMdd_HHmmss'), '.parquet')"
						}
					}
				]
			},
			{
				"name": "SP_UpdateWatermark",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_Incremental_Data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[brazilan_Ecommerce].[SP_UpdateWatermark]",
					"storedProcedureParameters": {
						"NewWatermarkValue": {
							"value": "@activity('LK_NewWM').output.firstRow.wm",
							"type": "String"
						},
						"RunId": {
							"value": "@pipeline().RunId",
							"type": "Guid"
						},
						"SourceId": {
							"value": "@pipeline().parameters.SourceId",
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "sourceAzSQL_to_adf",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"SourceId": {
				"type": "int"
			},
			"SourceSchemaName": {
				"type": "string"
			},
			"SourceTableName": {
				"type": "string"
			},
			"WatermarkColumn": {
				"type": "string"
			},
			"LookbackDays": {
				"type": "int"
			},
			"TargetSchemaName": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-07-08T13:55:17Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}