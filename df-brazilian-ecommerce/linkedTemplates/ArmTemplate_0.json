							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[brazilan_Ecommerce].[SP_UpdateWatermark]"
						},
						"linkedServiceName": {
							"referenceName": "sourceAzSQL_to_adf",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"SourceId": {
						"type": "int"
					},
					"SourceSchemaName": {
						"type": "string"
					},
					"SourceTableName": {
